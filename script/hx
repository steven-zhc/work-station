#!/usr/bin/env bash
#
# hx - herdr workspace selector (the herdr counterpart of ./tx)
#
# Lists projects together with the state of whatever agent is running in them,
# sorted so that whatever needs you comes first, and opens or focuses the pick.
#
# See `hx -h` for usage, keys and configuration.

set -euo pipefail

HX_CONFIG_DIR="${HX_CONFIG_DIR:-$HOME/.config/hx}"
HX_CACHE_DIR="${HX_CACHE_DIR:-$HOME/.cache/hx}"
ROOTS_FILE="$HX_CONFIG_DIR/roots"
HISTORY_FILE="$HX_CACHE_DIR/history"
HISTORY_MAX=20

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

usage() {
    cat <<'EOF'
hx - herdr workspace selector

Usage:
  hx [query]              pick projects and open one space per project
  hx -                    jump back to the previous space
  hx -a KIND [query]      also start an agent (claude, codex, ...) in each
  hx -w BRANCH [query]    open a git worktree of the project on BRANCH
  hx -h                   this help

Search for projects and mark as many as you want with tab. Each marked project
becomes its own herdr space; hx then focuses the first one and attaches, and
you switch between the spaces inside herdr.

Picker keys:
  tab      mark / unmark a project    ctrl-x   close the space
  enter    open the marked projects   ctrl-d   remove a worktree checkout
  ctrl-a   start an agent in each     ctrl-w   new git worktree

ctrl-w and ctrl-d act on a single project, so mark exactly one for those.

Projects are listed with their agent state, most urgent first:
  blocked (waiting on you) > done (finished, unseen) > working > idle > closed

Space layout:
  A space is laid out from the project's own .hx file when it has one, and from
  the default layout otherwise. Either way it is read once, when the space is
  created - edit .hx and the space has to be closed and reopened to pick it up.

  .hx is TOML (needs python3, whose tomllib reads it). One [[tab]] per tab, and
  a [[tab.pane]] for each extra pane split off the one before it in that tab:

    [[tab]]
    name = "edit"
    command = "nvim ."
      [[tab.pane]]
      name = "shell"
      size = 15               # percent of the space the new pane takes
      split = "down"          # "down" (default) or "right"

    [[tab]]
    name = "server"
    command = "pnpm dev"
      [[tab.pane]]
      name = "logs"
      command = "tail -f log"
      size = 30

    [[tab]]
    name = "console"

  Every key is optional: a tab with no command is a plain shell, a pane with no
  size splits in half. Commands are sent to the pane's shell verbatim, so write
  them for your shell. Panes stack: the second one splits off the first.

  The default layout, used when the project has no .hx file, is the equivalent
  of an "edit" tab running $EDITOR with a 15% shell below it, plus a "console"
  tab holding a plain shell. Both start in the project directory.

Config:
  ~/.config/hx/roots      where to look for projects, one path or glob per line
  <project>/.hx           that project's layout, taking precedence over the
                          default above

Env:
  EDITOR                  editor used by the default layout (default: vi)
  HX_SESSION              herdr session name to use
EOF
}

die() { echo "hx: $*" >&2; exit 1; }

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# A layout is normalised into a plan before anything is built, one tab or pane
# per line:  tab<US>name<US>command
#            pane<US>name<US>command<US>down|right<US>percent
# The separator is US (0x1f) rather than a tab because tab counts as IFS
# whitespace, which would collapse the empty fields of a pane with no command.
PLAN_SEP=$'\x1f'

plan_line() { local IFS="$PLAN_SEP"; printf '%s\n' "$*"; }

# Written directly, so a project without a .hx file never needs the TOML reader.
default_plan() {
    plan_line tab  edit    "${EDITOR:-vi} ."
    plan_line pane shell   "" down 15
    plan_line tab  console ""
}

# Reads a project's .hx (TOML) and prints the same plan. tomllib is stdlib from
# Python 3.11, so this needs no package beyond python3 itself.
plan_from_toml() {
    python3 - "$1" <<'PY'
import sys, tomllib

SEP = "\x1f"
path = sys.argv[1]
try:
    with open(path, "rb") as fh:
        doc = tomllib.load(fh)
except (OSError, tomllib.TOMLDecodeError) as exc:
    sys.exit(f"hx: {path}: {exc}")

def text(table, key, where):
    value = table.get(key, "")
    if value is None:
        return ""
    if not isinstance(value, str):
        sys.exit(f"hx: {path}: {where}.{key} must be a string")
    if any(c in value for c in "\t\n\x1f"):
        sys.exit(f"hx: {path}: {where}.{key} must not contain tabs or newlines")
    return value

tabs = doc.get("tab", [])
if not isinstance(tabs, list) or not tabs:
    sys.exit(f"hx: {path}: needs at least one [[tab]]")

lines = []
for ti, tab in enumerate(tabs):
    where = f"tab[{ti}]"
    if not isinstance(tab, dict):
        sys.exit(f"hx: {path}: {where} must be a table")
    lines.append(SEP.join(["tab", text(tab, "name", where), text(tab, "command", where)]))

    panes = tab.get("pane", [])
    if not isinstance(panes, list):
        sys.exit(f"hx: {path}: {where}.pane must be a list of tables")
    for pi, pane in enumerate(panes):
        pwhere = f"{where}.pane[{pi}]"
        if not isinstance(pane, dict):
            sys.exit(f"hx: {path}: {pwhere} must be a table")
        split = pane.get("split", "down")
        if split not in ("down", "right"):
            sys.exit(f"hx: {path}: {pwhere}.split must be \"down\" or \"right\"")
        size = pane.get("size", 50)
        if not isinstance(size, int) or isinstance(size, bool) or not 1 <= size <= 99:
            sys.exit(f"hx: {path}: {pwhere}.size must be an integer between 1 and 99")
        lines.append(SEP.join(
            ["pane", text(pane, "name", pwhere), text(pane, "command", pwhere), split, str(size)]))

print("\n".join(lines))
PY
}

# ---------------------------------------------------------------- herdr access

require_bins() {
    local bin
    for bin in "$@"; do
        command -v "$bin" >/dev/null 2>&1 || die "$bin is required but not installed"
    done
}

# The CLI talks to a running server over the local socket, so make sure one is
# up before reading or creating any topology.
ensure_server() {
    herdr status server >/dev/null 2>&1 && return 0
    nohup herdr server >/dev/null 2>&1 &
    local _i
    for _i in $(seq 1 50); do
        herdr status server >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    die "could not reach a herdr server"
}

herdr_json() { herdr "$@" 2>/dev/null || echo '{}'; }

# herdr nests its JSON differently per command, so every lookup below walks the
# whole document instead of hard-coding a path, and accepts a few plausible
# spellings per field. This is the one place to fix if a response shape changes.
JQ_LIB='
def pick(fields): [fields] | map(select(type == "string")) | first // "";
def wlabel: pick(.label?, .name?);
def wcwd:   pick(.cwd?, .path?, .directory?);
def aname:  pick(.name?, .agent?, .agent_name?, .kind?);
def astate: pick(.state?, .status?, .agent_state?, .lifecycle?) | ascii_downcase;
def owner($o): ($o.workspace_id? | strings) // (($o.pane_id? // "") | split(":") | .[0]);
def workspaces: [.. | objects
    | select(has("workspace_id") and (has("pane_id") | not) and (has("tab_id") | not))]
    | unique_by(.workspace_id);
def panes: [.. | objects | select(has("pane_id"))] | unique_by(.pane_id);
def agentlist: [.. | objects | select(has("pane_id") and astate != "")]
    | unique_by(.pane_id);
def rank($s): {"blocked":0,"done":1,"working":2,"unknown":3,"idle":4}[$s] // 3;
def pad($n): . as $s | ($n - ($s | length)) as $k
    | if $k > 0 then $s + (" " * $k) else $s end;
'

# --------------------------------------------------------------- project roots

seed_roots_file() {
    [[ -f $ROOTS_FILE ]] && return 0
    mkdir -p "$HX_CONFIG_DIR"
    cat > "$ROOTS_FILE" <<'EOF'
# hx project roots - one path or glob per line, ~ is expanded.
# Git repos that zoxide knows about are picked up automatically as well.
~/.dotfile
~/Workspace/*
~/Workspace/*/*
EOF
    return 0
}

candidate_dirs() {
    local line f
    {
        while IFS= read -r line; do
            line="${line%%#*}"
            line="$(trim "$line")"
            [[ -z $line ]] && continue
            line="${line/#\~/$HOME}"
            for f in $line; do           # deliberately unquoted: expand the glob
                if [[ -d $f ]]; then printf '%s\n' "${f%/}"; fi
            done
        done < "$ROOTS_FILE"

        if command -v zoxide >/dev/null 2>&1; then
            while IFS= read -r f; do
                if [[ -d "$f/.git" ]]; then printf '%s\n' "${f%/}"; fi
            done < <(zoxide query -l 2>/dev/null || true)
        fi
    } | awk '!seen[$0]++'
}

# Order closed projects by zoxide frecency first, then alphabetically.
rank_dirs() {
    local frecent=""
    if command -v zoxide >/dev/null 2>&1; then
        frecent="$(zoxide query -l 2>/dev/null || true)"
    fi
    awk -v frecent="$frecent" '
        BEGIN {
            n = split(frecent, f, "\n")
            for (i = 1; i <= n; i++) { sub(/\/$/, "", f[i]); if (!(f[i] in ord)) ord[f[i]] = i }
        }
        { printf "%06d\t%s\n", ($0 in ord ? ord[$0] : 999999), $0 }
    ' | sort -t$'\t' -k1,1n -k2,2 | cut -f2-
}

# ---------------------------------------------------------------- row building
#
# Rows are tab separated; field 7 is the only one fzf displays:
#   1 rank  2 state  3 workspace_id  4 pane_id  5 agent  6 cwd  7 display
# Empty machine fields are written as "-" so they survive fzf's {n} expansion.

build_rows() {
    local ws_json agents_json panes_json open_rows open_cwds

    ws_json="$(herdr_json workspace list)"
    agents_json="$(herdr_json agent list)"
    panes_json="$(herdr_json pane list)"

    open_rows="$(jq -rn \
        --argjson ws "$ws_json" --argjson ag "$agents_json" --argjson pn "$panes_json" \
        --arg home "$HOME" "$JQ_LIB"'
        ($ag | agentlist | map({ws: owner(.), pane: .pane_id, name: aname, state: astate})) as $agents
        | ($pn | panes | map({ws: owner(.), pane: .pane_id})) as $panes
        | $ws | workspaces
        | map(
            . as $w
            | $w.workspace_id as $id
            | ($agents | map(select(.ws == $id)) | sort_by(rank(.state))) as $mine
            | ($mine | first) as $top
            | (if $top then $top.state else "idle" end) as $state
            | (if $top then $top.pane
               else (($panes | map(select(.ws == $id)) | first).pane // "") end) as $pane
            | ($w | wcwd) as $cwd
            | {
                rank:  rank($state),
                state: $state,
                id:    $id,
                pane:  (if $pane == "" then "-" else $pane end),
                agent: (if $top != null and $top.name != "" then $top.name else "-" end),
                cwd:   (if $cwd  == "" then "-" else $cwd  end),
                label: (if ($w | wlabel) != "" then ($w | wlabel)
                        else ($cwd | split("/") | last) end)
              }
          )
        | sort_by(.rank, .label)
        | .[]
        | (if (.cwd | startswith($home)) then "~" + (.cwd | ltrimstr($home)) else .cwd end) as $short
        | ({"blocked":"\u001b[1;31m","done":"\u001b[1;32m","working":"\u001b[1;33m"}[.state]
           // "\u001b[2m") as $colour
        | [ (.rank | tostring), .state, .id, .pane, .agent, .cwd,
            ($colour + (.state | pad(8)) + "\u001b[0m " + ($short | pad(38))
             + (if .agent == "-" then "" else " \u001b[2m" + .agent + "\u001b[0m" end))
          ] | @tsv
    ')"

    if [[ -n $open_rows ]]; then printf '%s\n' "$open_rows"; fi

    # Everything on disk that is not already an open workspace.
    open_cwds="$(printf '%s\n' "$open_rows" | cut -f6 | grep -v '^-\{0,1\}$' || true)"
    candidate_dirs \
        | { grep -vxF "${open_cwds:-$'\001'}" || true; } \
        | rank_dirs \
        | while IFS= read -r dir; do
            printf '5\t-\t-\t-\t-\t%s\t         \033[0m%s\n' "$dir" "${dir/#$HOME/\~}"
          done
}

# ------------------------------------------------------------- open and layout

# Sets WS_ID. Creates the workspace and applies its layout when it is not open.
open_or_focus() {
    local dir="$1" name id created tab pane plan
    name="$(basename "$dir" | tr . '_')"

    id="$(herdr_json workspace list | jq -r --arg cwd "$dir" --arg label "$name" "$JQ_LIB"'
        workspaces | map(select(wcwd == $cwd or wlabel == $label)) | first | .workspace_id // empty')"

    WS_TAB=""
    if [[ -z $id ]]; then
        # Resolve the layout before creating anything: a broken .hx should stop
        # here rather than leave an empty space behind.
        plan="$(layout_plan "$dir")" || exit 1

        echo "Create space $name"
        created="$(herdr workspace create --cwd "$dir" --label "$name" --no-focus)"
        id="$(echo "$created" | jq -r '.result.workspace.workspace_id')"
        tab="$(echo "$created" | jq -r '.result.tab.tab_id')"
        pane="$(echo "$created" | jq -r '.result.root_pane.pane_id')"
        apply_plan "$plan" "$dir" "$id" "$tab" "$pane"
        WS_TAB="${LAYOUT_FIRST_TAB:-$tab}"
    fi

    # Focusing is the caller's job: opening several spaces at once should not
    # make the focus jump through every one of them on the way.
    WS_ID="$id"
    history_push "$dir"
}

focus_space() {  # ws_id [tab_id]
    herdr workspace focus "$1" >/dev/null
    if [[ -n ${2:-} ]]; then herdr tab focus "$2" >/dev/null; fi
}

# layout_plan resolves a project's layout - its own .hx, or the default - into
# the plan format described above, and fails without touching herdr if the .hx
# is broken. apply_plan then builds it, setting LAYOUT_FIRST_TAB so the caller
# can focus the tab the layout starts with.
layout_plan() {
    local dir="$1"
    if [[ -f "$dir/.hx" ]]; then
        require_bins python3
        plan_from_toml "$dir/.hx"
    else
        default_plan
    fi
}

apply_plan() {
    local plan="$1" dir="$2" ws="$3" root_tab="$4" root_pane="$5"
    local kind name cmd split size ratio resp cur_pane tab_id first=1
    LAYOUT_FIRST_TAB=""

    cur_pane="$root_pane"

    # Read on fd 3 so the herdr calls below keep their own stdin.
    while IFS="$PLAN_SEP" read -r kind name cmd split size <&3; do
        [[ -n $kind ]] || continue
        case "$kind" in
            pane)
                # --ratio is the share kept by the first (top or left) pane.
                ratio="$(awk -v p="$size" 'BEGIN { printf "%.2f", (100 - p) / 100 }')"
                resp="$(herdr pane split "$cur_pane" --direction "$split" --ratio "$ratio" \
                    --cwd "$dir" --no-focus)"
                cur_pane="$(echo "$resp" | jq -r '.result.pane.pane_id')"
                if [[ -n $name ]]; then herdr pane rename "$cur_pane" "$name" >/dev/null; fi
                ;;
            tab)
                if [[ $first == 1 ]]; then
                    # The workspace already came with a tab and a root pane; the
                    # only thing missing is the name the layout asks for.
                    tab_id="$root_tab"
                    cur_pane="$root_pane"
                    first=0
                    if [[ -n $name ]]; then herdr tab rename "$tab_id" "$name" >/dev/null; fi
                else
                    resp="$(herdr tab create --workspace "$ws" --cwd "$dir" \
                        --label "${name:-shell}" --no-focus)"
                    tab_id="$(echo "$resp" | jq -r '.result.tab.tab_id')"
                    cur_pane="$(echo "$resp" | jq -r '.result.root_pane.pane_id')"
                fi
                if [[ -z $LAYOUT_FIRST_TAB ]]; then LAYOUT_FIRST_TAB="$tab_id"; fi
                ;;
            *) echo "hx: ignoring unknown plan entry '$kind'" >&2 ;;
        esac

        if [[ -n $cmd ]]; then herdr pane run "$cur_pane" "$cmd" >/dev/null; fi
    done 3<<< "$plan"

    return 0
}

# ---------------------------------------------------------------------- extras

# Agent names must match [a-z][a-z0-9_-]{0,31}.
agent_name_for() {
    local base
    base="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' \
            | sed 's/-\{2,\}/-/g; s/^[^a-z]*//; s/-*$//')"
    printf '%.32s' "${base:-agent}-$2"
}

start_agent() {  # ws_id cwd kind
    local ws="$1" dir="$2" kind="$3" resp pane name
    # A fresh tab guarantees the clean, idle shell that `agent start` requires.
    resp="$(herdr tab create --workspace "$ws" --cwd "$dir" --label "$kind" --no-focus)"
    pane="$(echo "$resp" | jq -r '.result.root_pane.pane_id')"
    name="$(agent_name_for "$(basename "$dir")" "$kind")"
    echo "Starting $kind as '$name'"
    herdr agent start "$name" --kind "$kind" --pane "$pane" >/dev/null
}

make_worktree() {  # ws_id cwd branch
    local ws="$1" dir="$2" branch="$3"
    [[ -d "$dir/.git" ]] || die "$dir is not a git repository"
    if [[ -n $ws && $ws != "-" ]]; then
        herdr worktree create --workspace "$ws" --branch "$branch" --focus >/dev/null
    else
        herdr worktree create --cwd "$dir" --branch "$branch" --focus >/dev/null
    fi
}

remove_worktree() {  # ws_id
    local ws="$1" yn
    [[ -n $ws && $ws != "-" ]] || die "that project is not open, nothing to remove"
    if herdr worktree remove --workspace "$ws" >/dev/null 2>&1; then return 0; fi
    read -r -p "git refused (dirty checkout?) - remove anyway? [y/N] " yn || true
    case "$yn" in
        [yY]*) herdr worktree remove --workspace "$ws" --force >/dev/null ;;
        *)     echo "left alone" ;;
    esac
}

# --------------------------------------------------------------------- history

history_push() {
    local dir="$1"
    mkdir -p "$HX_CACHE_DIR"
    {
        printf '%s\n' "$dir"
        if [[ -f $HISTORY_FILE ]]; then grep -vxF "$dir" "$HISTORY_FILE" || true; fi
    } | head -"$HISTORY_MAX" > "$HISTORY_FILE.tmp"
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

previous_dir() {
    [[ -f $HISTORY_FILE ]] || return 1
    local current=""
    if [[ -n ${HERDR_WORKSPACE_ID:-} ]]; then
        current="$(herdr_json workspace get "$HERDR_WORKSPACE_ID" \
            | jq -r "$JQ_LIB"'workspaces | first | wcwd // empty' || true)"
    fi
    grep -vxF "${current:-$'\001'}" "$HISTORY_FILE" | head -1
}

# --------------------------------------------------------------------- preview

cmd_preview() {  # state ws_id pane_id cwd
    local pane="${3:--}" dir="${4:-}" readme
    if [[ $pane != "-" ]]; then
        herdr pane read "$pane" --source visible --ansi 2>/dev/null && return 0
    fi
    [[ -d $dir ]] || { echo "$dir (missing)"; return 0; }
    if [[ -d "$dir/.git" ]]; then
        git -C "$dir" -c color.ui=always status -sb 2>/dev/null | head -15 || true
        echo
        git -C "$dir" -c color.ui=always log --oneline -10 2>/dev/null || true
    else
        ls -A "$dir" | head -30 || true
    fi
    for readme in README.md readme.md README; do
        if [[ -f "$dir/$readme" ]]; then
            echo; echo "--- $readme ---"; head -20 "$dir/$readme"; break
        fi
    done
    return 0
}

# ------------------------------------------------------------------------ main

attach_if_outside() {
    [[ -n ${HERDR_ENV:-} ]] && return 0
    if [[ -n ${HX_SESSION:-} ]]; then exec herdr --session "$HX_SESSION"; fi
    exec herdr
}

main() {
    local agent_kind="" worktree_branch="" query="" jump_back=0
    local dir="" ws="-" key="" out="" rows="" line=""
    local first_ws="" first_tab="" first_dir=""
    SEL_DIRS=(); SEL_WS=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --preview)     shift; cmd_preview "$@"; return 0 ;;
            -h|--help)     usage; return 0 ;;
            -)             jump_back=1; shift ;;
            -a|--agent)    agent_kind="${2:-}";     [[ -n $agent_kind ]]      || die "-a needs an agent kind"; shift 2 ;;
            -w|--worktree) worktree_branch="${2:-}"; [[ -n $worktree_branch ]] || die "-w needs a branch";     shift 2 ;;
            -*)            die "unknown option $1" ;;
            *)             query="$1"; shift ;;
        esac
    done

    require_bins herdr fzf jq
    if [[ -n ${HX_SESSION:-} ]]; then export HERDR_SESSION="$HX_SESSION"; fi
    seed_roots_file
    ensure_server

    if [[ $jump_back == 1 ]]; then
        dir="$(previous_dir || true)"
        [[ -n $dir ]] || die "no previous workspace"
        SEL_DIRS=("$dir"); SEL_WS=("-")
    else
        # --multi: tab marks a project, so one pass through the picker can open
        # several spaces at once. With --expect the key comes back on line 1 and
        # every marked row after it.
        out="$(build_rows | fzf --ansi --multi --delimiter=$'\t' --with-nth=7 \
                --query="$query" \
                --expect=ctrl-w,ctrl-a,ctrl-x,ctrl-d \
                --header='tab mark   enter open   ctrl-a agent   ctrl-w worktree   ctrl-x close   ctrl-d rm worktree' \
                --preview="$SELF --preview {2} {3} {4} {6}" \
                --preview-window='right:55%')" || out=""
        [[ -n $out ]] || return 0
        key="$(printf '%s\n' "$out" | head -1)"
        rows="$(printf '%s\n' "$out" | tail -n +2)"
        [[ -n $rows ]] || return 0
        while IFS= read -r line; do
            [[ -n $line ]] || continue
            IFS=$'\t' read -r _ _ ws _ _ dir _ <<< "$line"
            SEL_DIRS+=("$dir"); SEL_WS+=("$ws")
        done <<< "$rows"
        [[ ${#SEL_DIRS[@]} -gt 0 ]] || return 0
        dir="${SEL_DIRS[0]}"; ws="${SEL_WS[0]}"
    fi

    local i n="${#SEL_DIRS[@]}"

    case "$key" in
        ctrl-x)
            for ((i = 0; i < n; i++)); do
                if [[ ${SEL_WS[$i]} == "-" ]]; then
                    echo "hx: ${SEL_DIRS[$i]} is not open, skipped" >&2
                else
                    herdr workspace close "${SEL_WS[$i]}" >/dev/null
                    echo "Closed ${SEL_DIRS[$i]}"
                fi
            done
            return 0 ;;
        ctrl-d)
            # Deleting a checkout is destructive; never do it to a whole batch.
            [[ $n == 1 ]] || die "ctrl-d removes a worktree checkout, mark exactly one project"
            remove_worktree "$ws"
            return 0 ;;
        ctrl-w)
            # One branch name cannot sensibly cover several repos.
            [[ $n == 1 ]] || die "ctrl-w takes one branch, mark exactly one project"
            if [[ -z $worktree_branch ]]; then read -r -p "branch: " worktree_branch || true; fi
            [[ -n $worktree_branch ]] || die "no branch given"
            make_worktree "$ws" "$dir" "$worktree_branch"
            attach_if_outside
            return 0 ;;
        ctrl-a)
            if [[ -z $agent_kind ]]; then read -r -p "agent kind [claude]: " agent_kind || true; fi
            agent_kind="${agent_kind:-claude}" ;;
    esac

    if [[ -n $worktree_branch ]]; then
        [[ $n == 1 ]] || die "-w takes one branch, mark exactly one project"
        open_or_focus "$dir"
        make_worktree "$WS_ID" "$dir" "$worktree_branch"
        attach_if_outside
        return 0
    fi

    # Open every marked project as its own space, then focus the first one and
    # attach once - herdr keeps them all alive, switching between them is manual.
    for ((i = 0; i < n; i++)); do
        open_or_focus "${SEL_DIRS[$i]}"
        if [[ -n $agent_kind ]]; then start_agent "$WS_ID" "${SEL_DIRS[$i]}" "$agent_kind"; fi
        if [[ $i == 0 ]]; then first_ws="$WS_ID"; first_tab="$WS_TAB"; first_dir="${SEL_DIRS[$i]}"; fi
    done

    focus_space "$first_ws" "$first_tab"
    history_push "$first_dir"          # the space we land in belongs on top

    attach_if_outside
}

main "$@"
